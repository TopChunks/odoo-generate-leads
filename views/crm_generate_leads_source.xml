<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_iap_lead_mining_request_source_form" model="ir.ui.view">
        <field name="name">crm.iap.lead.mining.request.source.form</field>
        <field name="model">crm.iap.lead.mining.request</field>
        <field name="inherit_id" ref="crm_iap_mine.crm_iap_lead_mining_request_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='requests']" position="before">
                <group string="Lead Source">
                    <field name="source" widget="selection" readonly="state == 'done'"/>
                </group>
            </xpath>
            <field name="search_type" position="attributes">
                <attribute name="invisible">True</attribute>
                <attribute name="required">False</attribute>
            </field>
            <field name="lead_number" position="attributes">
                <attribute name="invisible">False</attribute>
                <attribute name="required">True</attribute>
            </field>
            <field name="industry_ids" position="attributes">
                <attribute name="invisible">False</attribute>
                <attribute name="required">True</attribute>
            </field>
            <field name="lead_number" position="attributes">
                <attribute name="string">Maximum Results / Leads</attribute>
            </field>
            <field name="filter_on_size" position="attributes">
                <attribute name="invisible">True</attribute>
            </field>
            <field name="company_size_min" position="attributes">
                <attribute name="invisible">True</attribute>
            </field>
            <field name="company_size_max" position="attributes">
                <attribute name="invisible">True</attribute>
            </field>
            <xpath expr="//label[@for='company_size_min']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
            <xpath expr="//footer/button[@name='action_submit']" position="attributes">
                <attribute name="invisible">not context.get('is_modal')</attribute>
            </xpath>
        </field>
    </record>

    <record id="crm_iap_lead_mining_request_tree_source" model="ir.ui.view">
        <field name="name">crm.iap.lead.mining.request.tree.source</field>
        <field name="model">crm.iap.lead.mining.request</field>
        <field name="inherit_id" ref="crm_iap_mine.crm_iap_lead_mining_request_view_tree"/>
        <field name="arch" type="xml">
            <field name="lead_number" position="before">
                <field name="source" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
